{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*", "test/**/*"],
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "nodenext",
    "strict": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
